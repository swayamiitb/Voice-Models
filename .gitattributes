# Normalize line endings: text files use LF in the repo, whatever locally.
* text=auto eol=lf

# Binary types — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.wav binary
*.mp3 binary
*.flac binary
*.onnx binary
*.pt binary
*.pth binary
*.ckpt binary
*.safetensors binary
